{
  "version": 1,
  "domain": "painting",
  "notes": "Hierarchical taste ontology. kind=scale: value 0..1 between poles [low,high]. kind=binary: 0/1 presence. kind=intensity: 0..1 strength. Categorical context (period, movement, region, medium) lives on the work record itself, not here — the model one-hot encodes it. Every tag on a work carries {v, c, src} = value, confidence 0..1, source: meta|clip|curated.",
  "groups": [
    { "id": "form", "label": "Form & handling" },
    { "id": "color", "label": "Color & light" },
    { "id": "comp", "label": "Composition & space" },
    { "id": "subject", "label": "Subject & setting" },
    { "id": "mood", "label": "Atmosphere & emotion" },
    { "id": "narr", "label": "Narrative" }
  ],
  "dims": [
    { "id": "form.abstraction", "group": "form", "kind": "scale", "label": "Abstraction", "poles": ["figurative", "abstract"] },
    { "id": "form.stylization", "group": "form", "kind": "scale", "label": "Stylization", "poles": ["naturalistic", "stylized"] },
    { "id": "form.brushwork", "group": "form", "kind": "scale", "label": "Brushwork", "poles": ["polished, invisible", "visible, gestural"] },
    { "id": "form.detail", "group": "form", "kind": "scale", "label": "Detail", "poles": ["spare", "intricate"] },
    { "id": "form.complexity", "group": "form", "kind": "scale", "label": "Visual complexity", "poles": ["minimal", "dense"] },
    { "id": "form.order", "group": "form", "kind": "scale", "label": "Order", "poles": ["ordered", "chaotic"] },
    { "id": "form.geometry", "group": "form", "kind": "scale", "label": "Geometry", "poles": ["organic", "geometric"] },
    { "id": "form.line", "group": "form", "kind": "scale", "label": "Line", "poles": ["painterly", "linear"] },
    { "id": "form.texture", "group": "form", "kind": "scale", "label": "Surface", "poles": ["smooth", "textured"] },

    { "id": "color.saturation", "group": "color", "kind": "scale", "label": "Saturation", "poles": ["muted", "vivid"] },
    { "id": "color.temperature", "group": "color", "kind": "scale", "label": "Temperature", "poles": ["cool", "warm"] },
    { "id": "color.restraint", "group": "color", "kind": "scale", "label": "Palette", "poles": ["restrained", "exuberant"] },
    { "id": "color.protagonism", "group": "color", "kind": "scale", "label": "Role of color", "poles": ["supporting", "protagonist"] },
    { "id": "color.contrast", "group": "color", "kind": "scale", "label": "Contrast", "poles": ["soft", "stark"] },
    { "id": "color.value", "group": "color", "kind": "scale", "label": "Overall value", "poles": ["dark", "luminous"] },
    { "id": "light.drama", "group": "color", "kind": "scale", "label": "Light", "poles": ["diffuse, even", "theatrical, dramatic"] },
    { "id": "light.natural", "group": "color", "kind": "binary", "label": "Natural light" },
    { "id": "light.nocturne", "group": "color", "kind": "binary", "label": "Night scene" },

    { "id": "comp.depth", "group": "comp", "kind": "scale", "label": "Depth", "poles": ["flat", "deep space"] },
    { "id": "comp.centrality", "group": "comp", "kind": "scale", "label": "Focus", "poles": ["distributed", "central figure"] },
    { "id": "comp.openness", "group": "comp", "kind": "scale", "label": "Framing", "poles": ["closed, contained", "open, cropped"] },
    { "id": "comp.symmetry", "group": "comp", "kind": "scale", "label": "Symmetry", "poles": ["asymmetric", "symmetric"] },
    { "id": "comp.negativespace", "group": "comp", "kind": "scale", "label": "Negative space", "poles": ["filled", "generous emptiness"] },
    { "id": "comp.scale", "group": "comp", "kind": "scale", "label": "Felt scale", "poles": ["intimate", "monumental"] },
    { "id": "comp.movement", "group": "comp", "kind": "scale", "label": "Motion", "poles": ["stillness", "movement"] },

    { "id": "subject.portrait", "group": "subject", "kind": "binary", "label": "Portrait" },
    { "id": "subject.figure", "group": "subject", "kind": "binary", "label": "Human figure" },
    { "id": "subject.group", "group": "subject", "kind": "binary", "label": "Group scene" },
