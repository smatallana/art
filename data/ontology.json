    { "id": "subject.animal", "group": "subject", "kind": "binary", "label": "Animals" },
    { "id": "subject.marine", "group": "subject", "kind": "binary", "label": "Sea" },
    { "id": "subject.humanpresence", "group": "subject", "kind": "scale", "label": "Human presence", "poles": ["absent", "dominant"] },
    { "id": "subject.facevisible", "group": "subject", "kind": "binary", "label": "Face visible" },
    { "id": "subject.gazedirect", "group": "subject", "kind": "binary", "label": "Direct gaze" },
    { "id": "subject.crowd", "group": "subject", "kind": "scale", "label": "Cast", "poles": ["individual", "multitude"] },

    { "id": "mood.serenity", "group": "mood", "kind": "intensity", "label": "Serenity" },
    { "id": "mood.joy", "group": "mood", "kind": "intensity", "label": "Joy" },
