# ── Beholder deployment credentials ─────────────────────────────────────────
# These are GitHub Actions secrets (Settings → Secrets and variables → Actions).
# They are NEVER committed. Local frontend development needs none of them.

# Cloudflare (required from M1 for R2 image hosting; M4 for Workers + D1)
# Create at https://dash.cloudflare.com → My Profile → API Tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Google OAuth (required at M4 for sign-in)
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker-side secrets (set via `wrangler secret put`, not in files)
# BETTER_AUTH_SECRET=   # generated: openssl rand -base64 32
